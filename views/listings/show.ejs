<% layout('layouts/boilerplate') %>
<div class="row mt-3">
    <div class="col-8 offset-3">
       <h3>Listing Details</h3>
    </div>

    <div class="card col-5 offset-3 show-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listingimage"/>
        <div class="card-body">
             <b><p class="card-text"><%= listing.title %></b><br>
             description: <%= listing.description %><br>
             link: <%= listing.image.url %><br>
             price: &#8377; <%= listing.price.toLocaleString("en-IN") %> <br>
             country: <%= listing.country %> <br>
             location: <%= listing.location %></p>
        </div>
    </div>
    <br>
    
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
    
        <form class="delete" method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
           <button class="btn btn-dark 'offset-5">Delete</button>
       </form>
    </div>
</div>